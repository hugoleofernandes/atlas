<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Consume side for all integration events processed by the OutboxWorker.
    Organised by publishing module → aggregate root → event, so you can open
    one folder and see every handler (fan-out) triggered by that event.
    Referenced by Atlas.Outbox.Worker only.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Atlas.Contracts\Atlas.Integration.Contracts.csproj" />
    <ProjectReference Include="..\Atlas.Identity.Application\Atlas.Identity.Application.csproj" />
    <ProjectReference Include="..\Atlas.Staff.Application\Atlas.Staff.Application.csproj" />
    <ProjectReference Include="..\Atlas.SharedKernel\Atlas.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
