{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=atlas;Username=atlas;Password=atlas_dev_password"
  },
  "OutboxWorker": {
    "DispatchMode": "Http",
    "InternalApiKey": "dev-outbox-worker-key",
    "BatchSize": 50,
    "DegreeOfParallelism": 4,
    "MaxRetries": 5,
    "LockDuration": "00:00:30",
    "PollInterval": "00:00:05",
    "Subscriptions": {
      "UserCreatedFromInvitationIntegrationEvent": [
        {
          "Name": "staff.create-member-from-invitation",
          "Method": "POST",
          "Url": "https://localhost:7106/internal/staff/events/user-created-from-invitation/create-staff-member",
          "Order": 10,
          "Enabled": true
        },
        {
          "Name": "identity.send-welcome-email",
          "Method": "POST",
          "Url": "https://localhost:7106/internal/identity/events/user-created-from-invitation/send-welcome-email",
          "Order": 20,
          "Enabled": true
        }
      ]
    }
  },
  "OpenTelemetry": {
    "ServiceName": "atlas-outbox-worker",
    "ServiceVersion": "1.0.0",
    "Endpoint": "",
    "ApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
