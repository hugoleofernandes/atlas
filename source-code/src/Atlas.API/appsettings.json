{
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "atlas-api",
    "ServiceVersion": "1.0.0",
    "Endpoint": "",
    "ApiKey": ""
  },
  "Authentication": {
    "Authority": "https://placeholder.ciamlogin.com/placeholder.onmicrosoft.com/v2.0",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc/{tenant}",
    //"SignedOutCallbackPath": "/auth/logged-out-callback", nao usar essa config pq o front é um SPA
    "Scopes": "openid profile email",
    "UiLocales": "pt-BR"
  },
  "OutboxWorker": {
    "InternalApiKey": ""
  },
  "Email": {
    "Resend": {
      "ApiKey": "",
      "From": "Atlas <noreply@example.com>"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=atlas;Username=atlas;Password=atlas_dev_password"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173",
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimit": {
    "PermitLimit": 30,
    "WindowSeconds": 60,
    "QueueLimit": 5
  }
}
