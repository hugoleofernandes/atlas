<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Consume-side adapter added: this project now also orchestrates integration event → command
    dispatch, so it needs a reference to Atlas.Identity.Application for ISendWelcomeEmailCommandHandler.
    The dependency is one-way (Integration → Application) which is correct.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Atlas.Contracts\Atlas.Integration.Contracts.csproj" />
    <ProjectReference Include="..\Atlas.Identity.Application\Atlas.Identity.Application.csproj" />
    <ProjectReference Include="..\Atlas.Identity.Domain\Atlas.Identity.Domain.csproj" />
    <ProjectReference Include="..\Atlas.SharedKernel\Atlas.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
