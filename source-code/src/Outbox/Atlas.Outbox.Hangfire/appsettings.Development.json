{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=atlas;Username=atlas;Password=atlas_dev_password"
  },
  "OutboxWorker": {
    "LegacyHostedServiceEnabled": false,
    "DispatchMode": "Http",
    "PendingMessagesMode": "Database",
    "InternalApiKey": "dev-outbox-worker-key",
    "BatchSize": 50,
    "DegreeOfParallelism": 4,
    "MaxRetries": 5,
    "LockDuration": "00:00:30",
    "PollInterval": "00:00:05",
    "PendingMessagesUrls": {
      "identity": "https://localhost:7106/internal/identity/outbox/pending-messages",
      "staff": "https://localhost:7106/internal/staff/outbox/pending-messages"
    },
    "Subscriptions": {
      "UserCreatedFromInvitationIntegrationEvent": [
        {
          "Name": "staff.create-member-from-invitation",
          "Method": "POST",
          "Url": "https://localhost:7106/internal/staff/events/user-created-from-invitation/create-staff-member",
          "Order": 10,
          "Enabled": true
        },
        {
          "Name": "identity.send-welcome-email",
          "Method": "POST",
          "Url": "https://localhost:7106/internal/identity/events/user-created-from-invitation/send-welcome-email",
          "Order": 20,
          "Enabled": true
        }
      ]
    }
  },
  "HangfireOutbox": {
    "StorageConnectionStringName": "Default",
    "StorageSchema": "atlas_hangfire",
    "Urls": [
      "http://localhost:5230",
      "https://localhost:7230"
    ],
    "DashboardPath": "/hangfire",
    "RecurringCron": "* * * * *",
    "TriggerJobsOnStartup": true,
    "ProcessingWindow": "00:00:55",
    "WorkerCount": 2,
    "ServerName": "atlas-outbox-hangfire-dev",
    "DashboardAuth": {
      "Enabled": true,
      "Username": "admin",
      "Password": "dev-hangfire-password",
      "ReadOnly": false,
      "AllowInsecureHttp": true
    }
  },
  "OpenTelemetry": {
    "ServiceName": "atlas-outbox-hangfire",
    "ServiceVersion": "1.0.0",
    "Endpoint": "",
    "ApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
