<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Publish side for the Identity module.
    Maps Identity domain events → integration events → outbox messages.
    Referenced by Atlas.API (write side / SavePipeline).
  -->
