# Atlas local development environment variables.
# Copy this file to .env at the repository root and fill local-only values.
# .env is intentionally ignored by Git.

# Shared database used by Atlas.API and Atlas.Outbox.Worker.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=atlas;Username=atlas;Password=atlas_dev_password

# Docker Compose infrastructure.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
PGADMIN_EMAIL=admin@atlas.local
PGADMIN_PASSWORD=atlas_dev_password

# Internal service-to-service auth used by Atlas.Outbox.Worker -> Atlas.API internal endpoints.
OutboxWorker__InternalApiKey=dev-outbox-worker-key

# Transactional email provider used by Atlas.API internal Identity endpoints.
# Keep the real API key only in your local .env, user-secrets, or environment variables.
Email__Resend__ApiKey=
Email__Resend__From=Atlas <noreply@example.com>

# Optional observability config.
OpenTelemetry__Endpoint=
OpenTelemetry__ApiKey=
